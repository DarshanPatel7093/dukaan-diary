<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ Backup &amp; App Security"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#E2E8F0" />

        <!-- Backup Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☁️ GOOGLE DRIVE &amp; STORAGE BACKUP"
            android:textColor="#1D4ED8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Save all payments, service visits, customer records, and voice recordings so you never lose data when updating or reinstalling."
            android:textColor="#64748B"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackupSaveDrive"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="☁️  Save to Google Drive / Phone"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackupShare"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="📤  Share Backup (Drive / WhatsApp)"
            android:textColor="#2563EB"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:strokeColor="#BFDBFE" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackupRestore"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="📥  Restore from Google Drive / Phone"
            android:textColor="#16A34A"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="#BBF7D0" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="#E2E8F0" />

        <!-- Security Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 APP SECURITY &amp; PRIVACY"
            android:textColor="#B91C1C"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Protect your shop's accounts from other people holding your phone."
            android:textColor="#64748B"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbAppLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Lock App with Fingerprint / PIN"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLockStatusHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="Requires device screen lock to open the app"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseDialog"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:text="DONE"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>

